{
  "name": "johannschopplich/kirby-seo-audit",
  "description": "Yoast SEO and readability checks before the page goes live",
  "type": "kirby-plugin",
  "version": "3.5.1",
  "keywords": [
    "kirby",
    "kirby-cms",
    "kirby-plugin",
    "seo",
    "yoast",
    "readability"
  ],
  "license": "proprietary",
  "homepage": "https://kirby.tools/seo-audit",
  "authors": [
    {
      "name": "Johann Schopplich",
      "email": "hello@johannschopplich.com",
      "homepage": "https://johannschopplich.com"
    }
  ],
  "require": {
    "php": ">=8.2",
    "getkirby/composer-installer": "^1",
    "johannschopplich/kirby-tools-licensing": "^0.9",
    "johannschopplich/kirby-tools-utils": "^0.1.3"
  },
  "require-dev": {
    "getkirby/cms": "^5",
    "phpunit/phpunit": "^12",
    "vlucas/phpdotenv": "^5"
  },
  "scripts": {
    "dev": [
      "Composer\\Config::disableProcessTimeout",
      "@php -S localhost:8000 -t playground/public vendor/getkirby/cms/router.php"
    ],
    "csfix": "@php tools/phpcs/vendor/bin/php-cs-fixer fix",
    "test": "phpunit",
    "dist": "composer install --no-dev"
  },
  "autoload": {
    "psr-4": {
      "JohannSchopplich\\": "src/classes/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "allow-plugins": {
      "getkirby/composer-installer": true
    }
  },
  "extra": {
    "kirby-cms-path": false,
    "kirby": {
      "compatible": "^4.0 || ^5.0"
    }
  }
}
