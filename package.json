{
  "name": "kirby-seo-audit",
  "type": "module",
  "version": "3.5.1",
  "private": true,
  "packageManager": "pnpm@11.28.6",
  "scripts": {
    "dev": "PLAYGROUND=true kirbyup dev src/panel/index.ts",
    "build": "kirbyup src/panel/index.ts",
    "build:assets": "rm -rf assets && pnpm -C src/assets build",
    "build:playground": "PLAYGROUND=true pnpm run build",
    "build:zero-one": "ZERO_ONE=true pnpm run build && pnpm run build:assets && node scripts/build-zero-one.mjs",
    "prepare:yoastseo": "node scripts/prepare-yoastseo.mjs",
    "prepare:messages": "node scripts/extract-translations.mjs && npx po2json messages.pot messages.json --format jed1.x --domain wordpress-seo && sed -i '' 's/\"wordpress-seo\\\\u0004/\"/g' messages.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier \"src/panel/**\" \"tests/panel/**\" --write",
    "test": "vitest",
    "test:types": "vue-tsc --noEmit",
    "release": "pnpm run build && pnpm run build:assets && bumpp --all --execute \"npx zx scripts/pre-release.mjs\" && zx scripts/post-release.mjs"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@kirby-tools/licensing": "^1.1.0",
    "@types/node": "^26.6.5",
    "@unocss/eslint-plugin": "^66.11.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "bumpp": "^12.3.0",
    "eslint": "^10.13.0",
    "gettext-extractor": "^4.0.6",
    "happy-dom": "^21.0.3",
    "jiti": "^2.7.0",
    "kirby-types": "^2.0.0-beta.5",
    "kirbyup": "^4.0.0-beta.1",
    "kirbyuse": "^2.0.0-beta.5",
    "ohash": "^2.0.12",
    "prettier": "^3.9.10",
    "throttleit": "^3.0.0",
    "tinyglobby": "^0.2.17",
    "typescript": "^6.0.3",
    "unocss": "^66.11.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13",
    "zx": "^8.8.5"
  }
}
